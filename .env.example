# --- Server ---
# Postgres connection (matches docker-compose service "db")
DATABASE_URL=postgresql://hlm:changeme@localhost:5432/hlm

# 64 hex chars (32 bytes) — encrypts secrets at rest. BACK THIS UP; loss = unrecoverable secrets.
# Generate: openssl rand -hex 32
MASTER_KEY=

# WebAuthn / passkeys — must match the public HTTPS origin of your reverse proxy
RP_ID=hlm.example.lan
ORIGIN=https://hlm.example.lan
SESSION_SECRET=

# Server listen
PORT=3000
HOST=0.0.0.0

# --- Email reports (M3) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Postgres container ---
POSTGRES_USER=hlm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hlm
