generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A managed machine reachable over SSH (physical, VM, or LXC).
model Host {
  id        String   @id @default(cuid())
  alias     String   @unique
  hostname  String
  port      Int      @default(22)
  username  String
  notes     String   @default("")
  self      Boolean  @default(false) // true if this host runs the app (reboot deferred, M3.2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules UpdateSchedule[]
  jobSteps  JobStep[]
}

// Append-only audit trail. One row per step execution or mutating API action.
model AuditEntry {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actor      String // "operator" until multi-user exists
  action     String // dotted step name, e.g. host.register, health.check
  target     String   @default("")
  params     String   @default("{}") // JSON, secrets redacted
  ok         Boolean
  output     String   @default("")
  durationMs Int      @default(0)

  @@index([at])
}

// A Proxmox node: PVE hypervisor or PBS backup server.
// API token secret lives in the Secret table under "node-token-<id>".
model Node {
  id             String   @id @default(cuid())
  name           String   @unique
  type           String // "pve" | "pbs"
  url            String // e.g. https://pve1.lab:8006
  tokenId        String // user@realm!tokenname
  tlsFingerprint String   @default("") // TOFU-pinned on first successful connection
  status         String   @default("unknown") // unknown | up | down (last node.test)
  lastCheckedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A VM or LXC on a PVE node, refreshed by node.sync.
model Guest {
  id       String @id @default(cuid())
  nodeDbId String // FK to the Node row that reported this guest
  pveNode  String // physical PVE node name within the cluster
  vmid     Int
  type     String // "qemu" | "lxc"
  name     String
  status   String // running, stopped, paused, ...

  updatedAt DateTime @updatedAt

  @@unique([nodeDbId, vmid])
}

// Encrypted-at-rest secrets (AES-GCM via MASTER_KEY). id is a well-known name,
// e.g. "master-ssh-private-key".
model Secret {
  id         String   @id
  ciphertext String
  iv         String
  authTag    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// A registered WebAuthn passkey. The operator can have several (laptop, phone, backup key).
model Credential {
  id           String   @id @default(cuid())
  credentialId String   @unique // base64url WebAuthn credential ID
  publicKey    String // base64url COSE public key
  counter      BigInt   @default(0)
  transports   String   @default("") // comma-separated
  name         String   @default("") // operator's label, e.g. "laptop"
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
}

// An authenticated session. id is the opaque cookie token.
model Session {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// A manually-registered ping target.
model PingTarget {
  id                  String   @id @default(cuid())
  name                String   @unique
  host                String
  intervalSec         Int      @default(60)
  alertAfter          Int      @default(3) // consecutive failures before "down" + alert
  enabled             Boolean  @default(true)
  status              String   @default("unknown") // unknown | up | down
  consecutiveFailures Int      @default(0)
  lastLatencyMs       Int?
  lastCheckedAt       DateTime?
  notify              Boolean  @default(false) // send notifications on state transition
  notifyEmail         Boolean  @default(false) // include the email channel
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  results  CheckResult[]
  webhooks Webhook[]
}

// One ping result, time-bounded (7-day pruning by the scheduler).
model CheckResult {
  id        String   @id @default(cuid())
  targetId  String
  target    PingTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  ok        Boolean
  latencyMs Int?
  error     String   @default("")

  @@index([targetId, at])
}

// A webhook endpoint that alerts POST as JSON on state transitions.
// DB-backed so endpoints can change without restarting the container.
model Webhook {
  id        String   @id @default(cuid())
  name      String   @default("")
  url       String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targets PingTarget[]
}

// Simple key-value app settings (value is a string, "true"/"false" for flags).
// Well-known keys: "notify.email.enabled".
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A recurring update schedule: weekly day(s) + time of day, scoped to hosts.
// PVE/PBS nodes are registered as Hosts to receive OS updates (SSH; the
// Proxmox API has no apt endpoint).
model UpdateSchedule {
  id               String   @id @default(cuid())
  name             String   @unique
  daysOfWeek       Int[] // 0=Sunday .. 6=Saturday
  timeOfDay        String // "HH:MM", server-local time
  osUpdates        Boolean  @default(true)
  containerUpdates Boolean  @default(false)
  enabled          Boolean  @default(true)
  lastRunAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  hosts Host[]
  jobs  Job[]
}

// One execution of an update schedule (trigger="scheduled") or a manual run
// (trigger="manual"). Steps run sequentially per host; one host failing does
// not stop the job.
model Job {
  id         String    @id @default(cuid())
  trigger    String // scheduled | manual
  status     String    @default("running") // running | succeeded | failed
  scheduleId String?
  schedule   UpdateSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  steps JobStep[]
}

// One step within a job, tied to the host it ran on. Output is the combined
// tagged stream; rebootPending flags hosts needing a reboot (M3.2 acts on it).
model JobStep {
  id            String   @id @default(cuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  hostId        String?
  host          Host?    @relation(fields: [hostId], references: [id], onDelete: SetNull)
  name          String // dotted step name, e.g. os.update
  ok            Boolean
  output        String   @default("")
  rebootPending Boolean  @default(false)
  startedAt     DateTime @default(now())
  durationMs    Int      @default(0)

  @@index([jobId])
}
