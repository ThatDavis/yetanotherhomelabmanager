generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// M1 models: users/passkeys, nodes, hosts, secrets, audit log.
// Defined when the corresponding features land via /dev:start-feature.
model Healthcheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())
}
